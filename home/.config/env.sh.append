# shellcheck shell=sh
# Personal environment variables loaded by interactive Bash and Zsh shells.
#
# Example:
# export API_KEY=""

# base urls
export ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
export OLLAMA_BASE_URL="http://localhost:11434/v1"
export OPENAI_BASE_URL="https://api.openai.com/v1"
export OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"
export OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"

# nvim codecompanion
export NVIM_CC_BASE_URL="https://opencode.ai/zen/go"
export NVIM_CC_API_KEY=""
export NVIM_CC_MODEL="deepseek-v4-flash"

# nvim gp.nvim
export NVIM_GP_PROVIDER="opencode"
export NVIM_GP_BASE_URL="${OPENCODE_GO_BASE_URL}"
export NVIM_GP_API_KEY=""
export NVIM_GP_CHAT_MODEL="deepseek-v4-flash"
export NVIM_GP_COMMAND_MODEL="deepseek-v4-flash"

# opencode
export CONTEXT7_API_KEY=""
