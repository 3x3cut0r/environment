{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "*": "allow",

    // Read-only tools: always allow
    "read": {
      "*": "allow",

      // Secret-like files should never be readable
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny"
    },

    "glob": {
      "*": "allow"
    },

    "grep": {
      "*": "allow"
    },

    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",

    // Internal tracking and interaction tools
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    
    // Ask before accessing external locations, but always deny secret-like files.
    "external_directory": {
      "*": "ask",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",

      "*/.env": "deny",
      "*/.env.*": "deny",
      "*/.credentials*": "deny",
      "*/.secret*": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny"
    }
 },

  "agent": {
    "build": {
      "description": "Primary agent for development with full tool access",
      "mode": "primary",
      "model": "anthropic/claude-opus-4-6",
      "prompt": "{file:./prompts/build.txt}",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "description": "Analysis and planning agent without making changes",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "{file:./prompts/plan.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "prompt": "{file:./prompts/explore.txt}",
      "temperature": 0.0,
      "steps": 16,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny"
      }
    },
    "general": {
      "description": "General-purpose agent for multi-step tasks and research",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "{file:./prompts/general.txt}",
      "temperature": 0.2,
      "steps": 25
    },
    "code-reviewer": {
      "description": "Reviews code for quality, best practices and potential issues",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "{file:./prompts/code-reviewer.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny"
      }
    },
    "debugger": {
      "description": "Agent focused on debugging and log analysis",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "prompt": "{file:./prompts/debugger.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "test-runner": {
      "description": "Runs tests and analyzes results",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "prompt": "{file:./prompts/test-runner.txt}",
      "temperature": 0.0,
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "question": "deny"
      }
    },
    "docs-writer": {
      "description": "Writes and maintains project documentation",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "prompt": "{file:./prompts/docs-writer.txt}",
      "temperature": 0.3,
      "steps": 12,
      "permission": {
        "edit": "ask",
        "bash": "deny"
      }
    },
    "security-auditor": {
      "description": "Performs security audits and identifies vulnerabilities",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "{file:./prompts/security-auditor.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny"
      }
    }
  }
}
