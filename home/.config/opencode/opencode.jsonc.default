{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "subagent_depth": 2,
  "agent": {
    "build": { "model": "opencode-go/glm-5.3", "variant": "high" },
    "plan": { "model": "opencode-go/glm-5.3", "variant": "high" },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "general": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "code-reviewer": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
    "debugger": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
    "log-analyzer": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "test-runner": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "docs-writer": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "security-auditor": { "model": "opencode-go/glm-5.3", "variant": "high" }
  },
  "permission": {
    "*": "deny",
    // MCP tool IDs are "<server>_<tool>", so every MCP server needs its own allow rule here.
    "byterover_*": "allow",
    "context7_*": "allow",
    "fusion360_*": "allow",
    "n8n_*": "allow",
    "read": {
      "*": "allow",
      "**/.ssh": "deny",
      "**/.ssh/**": "deny",
      "*/id_rsa*": "deny",
      "*/id_ed25519*": "deny",
      "*/id_ecdsa*": "deny",
      "*/id_dsa*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/id_ecdsa*": "deny",
      "**/id_dsa*": "deny",
      "**/ssh_host_*_key*": "deny",
      "**/.gnupg/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/config.json": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.password-store/**": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.local/share/opencode/auth.json": "deny",
      "**/.local/share/opencode/mcp-auth.json": "deny",
      "**/.config/env.sh": "deny",
      "~/.config/env.sh": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.credentials*": "deny",
      "**/*.secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "external_directory": {
      "*": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "/home/*/.ssh": "deny",
      "/home/*/.ssh/*": "deny",
      "**/.ssh": "deny",
      "**/.ssh/**": "deny",
      "*/id_rsa*": "deny",
      "*/id_ed25519*": "deny",
      "*/id_ecdsa*": "deny",
      "*/id_dsa*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/id_ecdsa*": "deny",
      "**/id_dsa*": "deny",
      "**/ssh_host_*_key*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "/home/*/.gnupg/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "/home/*/.aws/*": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/config": "deny",
      "/home/*/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "/home/*/.docker/config.json": "deny",
      "~/.git-credentials": "deny",
      "/home/*/.git-credentials": "deny",
      "~/.netrc": "deny",
      "/home/*/.netrc": "deny",
      "~/.password-store/**": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "/home/*/.config/gh/hosts.yml": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/mcp-auth.json": "deny",
      "~/.config/env.sh": "deny",
      "**/.config/env.sh": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*/.credentials*": "deny",
      "*/.secret*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.credentials*": "deny",
      "**/.secret*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny"
    }
  },
  "mcp": {
    "byterover": {
      "type": "local",
      "command": [
        "brv",
        "mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "fusion360": {
      "type": "remote",
      "url": "http://127.0.0.1:27182/mcp",
      "enabled": false,
      "oauth": false
    },
    "n8n": {
      "type": "remote",
      "url": "https://n8n.3x3cut0r.de/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/target/**"
    ]
  }
}
