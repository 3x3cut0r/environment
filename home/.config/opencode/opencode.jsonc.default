{
  "$schema": "./schema/config.json",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "plan",
  "permission": {
    "*": "deny",
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.credentials*": "deny",
      "**/*.secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "external_directory": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.credentials*": "deny",
      "**/*.secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*/.credentials*": "deny",
      "*/.secret*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.credentials*": "deny",
      "**/.secret*": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "~/.config/env.sh": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "Primary agent for development with full tool access",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/build.txt}",
      "temperature": 0.2,
      "steps": 32,
      "permission": {
        "read": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "task": {
          "explore": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "test-runner": "allow",
          "docs-writer": "allow",
          "security-auditor": "allow"
        }
      }
    },
    "plan": {
      "description": "Analysis and planning agent without making changes",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/plan.txt}",
      "temperature": 0.1,
      "steps": 32,
      "permission": {
        "read": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "allow",
        "question": "allow",
        "task": {
          "explore": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "test-runner": "allow",
          "docs-writer": "allow",
          "security-auditor": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/explore.txt}",
      "temperature": 0,
      "steps": 32,
      "permission": {
        "read": {
          "*": "allow"
        },
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "edit": "deny",
        "bash": "deny",
        "question": "deny"
      }
    },
    "general": {
      "description": "General-purpose execution agent for multi-step tasks when no specialized subagent fits",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/general.txt}",
      "temperature": 0.2,
      "steps": 32,
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "edit": "allow",
        "bash": "allow",
        "question": "deny",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "code-reviewer": {
      "description": "Reviews code for quality, best practices and potential issues",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./prompts/code-reviewer.txt}",
      "temperature": 0.1,
      "steps": 32,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "read": "allow",
        "list": "allow",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "debugger": {
      "description": "Agent focused on debugging and log analysis",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/debugger.txt}",
      "temperature": 0.1,
      "steps": 32,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "read": "allow",
        "list": "allow",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "question": "deny",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "test-runner": {
      "description": "Runs tests and analyzes results",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/test-runner.txt}",
      "temperature": 0,
      "steps": 32,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "read": "allow",
        "list": "allow",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "docs-writer": {
      "description": "Writes and maintains project documentation",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/docs-writer.txt}",
      "temperature": 0.3,
      "steps": 32,
      "permission": {
        "read": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "security-auditor": {
      "description": "Performs security audits and identifies vulnerabilities",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/security-auditor.txt}",
      "temperature": 0.1,
      "steps": 32,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "~/.config/env.sh": "deny"
        },
        "read": "allow",
        "list": "allow",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    }
  },
  "mcp": {
    "byterover": {
      "type": "local",
      "command": [
        "brv",
        "mcp"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "n8n": {
      "type": "remote",
      "url": "https://n8n.3x3cut0r.de/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  }
}
