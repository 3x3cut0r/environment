{
  "$schema": "./schema/config.json",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "default_agent": "plan",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.credentials*": "deny",
      "**/*.secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "external_directory": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.credentials*": "deny",
      "**/*.secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.kdbx": "deny",
      "**/*.agekey": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*/.credentials*": "deny",
      "*/.secret*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.credentials*": "deny",
      "**/.secret*": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "~/.config/env.sh": "deny"
    }
  },
  "mcp": {
    "byterover": {
      "type": "local",
      "command": [
        "brv",
        "mcp"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "n8n": {
      "type": "remote",
      "url": "https://n8n.3x3cut0r.de/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  }
}
