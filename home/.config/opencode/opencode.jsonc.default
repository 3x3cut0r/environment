{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "*": "ask",

    // Read-only tools: always allow
    "read": {
      "*": "allow",

      // Secret-like files should never be readable
      "*.env": "deny",
      "*.env.*": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "lsp": "allow",
    "webfetch": {
      "*": "allow"
    },
    "websearch": {
      "*": "allow"
    },
    "codesearch": {
      "*": "allow"
    },

    // Allow access outside workspace specifically for HOME,
    // then block security-critical paths/files.
    "external_directory": {
      "*": "ask",
      "~/*": "allow",
      "$HOME/*": "allow",

      "~/.ssh/*": "deny",
      "$HOME/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "$HOME/.gnupg/*": "deny",
      "~/.aws/credentials": "deny",
      "$HOME/.aws/credentials": "deny",
      "~/.kube/config": "deny",
      "$HOME/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "$HOME/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "$HOME/.netrc": "deny",
      "~/.pypirc": "deny",
      "$HOME/.pypirc": "deny",
      "~/.npmrc": "deny",
      "$HOME/.npmrc": "deny",

      "~/*/.env": "deny",
      "~/*/.env.*": "deny",
      "~/*.credentials*": "deny",
      "~/*.secret*": "deny",
      "~/*.pem": "deny",
      "~/*.key": "deny",
      "~/*.p12": "deny",
      "~/*.pfx": "deny",
      "~/*/id_rsa": "deny",
      "~/*/id_ed25519": "deny"
    }
  },

  "agent": {
    "build": {
      "description": "Primary agent for development with full tool access",
      "mode": "primary",
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "description": "Analysis and planning agent without making changes",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.0,
      "steps": 12,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "general": {
      "description": "General-purpose agent for multi-step tasks and research",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.2,
      "steps": 25
    },
    "code-reviewer": {
      "description": "Reviews code for quality, best practices and potential issues",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "debugger": {
      "description": "Agent focused on debugging and log analysis",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask"
      }
    },
    "test-runner": {
      "description": "Runs tests and analyzes results",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.0,
      "steps": 8,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "allow"
      }
    },
    "docs-writer": {
      "description": "Writes and maintains project documentation",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.3,
      "steps": 12,
      "permission": {
        "edit": "ask",
        "bash": "deny"
      }
    },
    "security-auditor": {
      "description": "Performs security audits and identifies vulnerabilities",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    }
  }
}
