          "/home/*/.aws/credentials": "deny",
          "~/.kube/config": "deny",
          "/root/.kube/config": "deny",
          "/home/*/.kube/config": "deny",
          "~/.docker/config.json": "deny",
          "/root/.docker/config.json": "deny",
          "/home/*/.docker/config.json": "deny",
          "~/.netrc": "deny",
          "/root/.netrc": "deny",
          "/home/*/.netrc": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*.kdbx": "deny",
          "*.agekey": "deny",
          "*.credentials*": "deny",
          "*.secret*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "*/id_rsa": "deny",
          "*/id_ed25519": "deny",
          "~/.config/env.sh": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "task": {
          "explore": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "test-runner": "allow",
          "docs-writer": "allow",
          "security-auditor": "allow"
        }
      }
    },
