{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",

    "bash": {
      "*": "ask",

      // Destructive and high-risk commands
      "rm -rf / *": "deny",
      "rm -rf /*": "deny",
      "shred *": "deny",
      "mkfs*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "sfdisk *": "deny",
      "dd * of=/dev/*": "deny",

      // LVM/ZFS storage destruction
      "pvremove *": "deny",
      "vgremove *": "deny",
      "lvremove *": "deny",
      "zfs destroy *": "deny",
      "zpool destroy *": "deny",

      // Proxmox VM/LXC destruction
      "qm destroy *": "deny",
      "pct destroy *": "deny",
      "pvesm remove *": "deny",
      "docker inspect *": "deny",
      "docker compose config*": "deny",

      // Firewall and privileged system mutation
      "iptables *": "deny",
      "nft *": "deny",
      "ufw *": "deny",
      "chmod 777 /etc/*": "deny",
      "chown * /etc/*": "deny"
    },

    "external_directory": {
      "*": "ask",

      // Proxmox host and cluster state
      "/etc/pve/*": "deny",
      "/var/lib/pve-cluster/*": "deny",
      "/etc/ceph/*": "deny",

      // SSH, privilege, and system secrets
      "/etc/ssh/*": "deny",
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/sudoers": "deny",
      "/etc/sudoers.d/*": "deny",
      "/etc/ssl/private/*": "deny",
      "/etc/letsencrypt/*": "deny",

      // LXC sensitive locations
      "/etc/lxc/*": "deny",
      "/var/lib/lxc/*/config": "deny",
      "/var/lib/lxc/*/rootfs/etc/shadow": "deny",
      "/var/lib/lxc/*/rootfs/root/.ssh/*": "deny",

      // User and root key material
      "~/.ssh/*": "deny",
      "/root/.ssh/*": "deny",
      "/home/*/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "/root/.gnupg/*": "deny",
      "/home/*/.gnupg/*": "deny",

      // Cloud and orchestration credentials
      "~/.aws/credentials": "deny",
      "/root/.aws/credentials": "deny",
      "/home/*/.aws/credentials": "deny",
      "~/.kube/config": "deny",
      "/root/.kube/config": "deny",
      "/home/*/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "/root/.docker/config.json": "deny",
      "/home/*/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "/root/.netrc": "deny",
      "/home/*/.netrc": "deny",

      // Generic secret-like files
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.agekey": "deny",
      "*.credentials*": "deny",
      "*.secret*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny"
    }
  },

  "agent": {
    "build": {
      "description": "Primary agent for development with full tool access",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "prompt": "{file:./prompts/build.txt}",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "test-runner": "allow",
          "docs-writer": "allow",
          "security-auditor": "allow"
        }
      }
    },
    "plan": {
      "description": "Analysis and planning agent without making changes",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/plan.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "test-runner": "allow",
          "docs-writer": "allow",
          "security-auditor": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./prompts/explore.txt}",
      "temperature": 0.0,
      "steps": 16,
      "permission": {
        "read": {
          "*": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "edit": "deny",
        "bash": "deny",
        "question": "deny"
      }
    },
    "general": {
      "description": "General-purpose agent for multi-step tasks and research",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/general.txt}",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    },
    "code-reviewer": {
      "description": "Reviews code for quality, best practices and potential issues",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./prompts/code-reviewer.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    },
    "debugger": {
      "description": "Agent focused on debugging and log analysis",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./prompts/debugger.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    },
    "test-runner": {
      "description": "Runs tests and analyzes results",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex-mini",
      "prompt": "{file:./prompts/test-runner.txt}",
      "temperature": 0.0,
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    },
    "docs-writer": {
      "description": "Writes and maintains project documentation",
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "prompt": "{file:./prompts/docs-writer.txt}",
      "temperature": 0.3,
      "steps": 12,
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    },
    "security-auditor": {
      "description": "Performs security audits and identifies vulnerabilities",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/security-auditor.txt}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": {
          "explore": "allow"
        }
      }
    }
  }
}
