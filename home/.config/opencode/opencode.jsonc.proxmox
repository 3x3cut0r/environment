          "*.secret*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "*/id_rsa": "deny",
          "*/id_ed25519": "deny",
          "~/.config/env.sh": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    },
    "security-auditor": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": {
          "*": "allow",
          "/etc/pve/*": "deny",
          "/var/lib/pve-cluster/*": "deny",
          "/etc/ceph/*": "deny",
          "/etc/ssh/*": "deny",
          "/etc/shadow": "deny",
          "/etc/gshadow": "deny",
          "/etc/sudoers": "deny",
          "/etc/sudoers.d/*": "deny",
          "/etc/ssl/private/*": "deny",
          "/etc/letsencrypt/*": "deny",
          "/etc/lxc/*": "deny",
          "/var/lib/lxc/*/config": "deny",
          "/var/lib/lxc/*/rootfs/etc/shadow": "deny",
          "/var/lib/lxc/*/rootfs/root/.ssh/*": "deny",
          "~/.ssh/*": "deny",
          "/root/.ssh/*": "deny",
          "/home/*/.ssh/*": "deny",
          "~/.gnupg/*": "deny",
          "/root/.gnupg/*": "deny",
          "/home/*/.gnupg/*": "deny",
          "~/.aws/credentials": "deny",
          "/root/.aws/credentials": "deny",
          "/home/*/.aws/credentials": "deny",
          "~/.kube/config": "deny",
          "/root/.kube/config": "deny",
          "/home/*/.kube/config": "deny",
          "~/.docker/config.json": "deny",
          "/root/.docker/config.json": "deny",
          "/home/*/.docker/config.json": "deny",
          "~/.netrc": "deny",
          "/root/.netrc": "deny",
          "/home/*/.netrc": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*.kdbx": "deny",
          "*.agekey": "deny",
          "*.credentials*": "deny",
          "*.secret*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "*/id_rsa": "deny",
          "*/id_ed25519": "deny",
          "~/.config/env.sh": "deny"
        },
        "read": "allow",
        "list": "allow",
        "todowrite": "allow",
        "task": {
          "explore": "allow"
        }
      }
    }
  },
  "mcp": {
    "byterover": {
      "type": "local",
      "command": [
        "brv",
        "mcp"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "n8n": {
      "type": "remote",
      "url": "https://n8n.3x3cut0r.de/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  }
}
