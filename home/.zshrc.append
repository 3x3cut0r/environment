# shellcheck shell=bash
export EDITOR="nvim"
export VISUAL="nvim"

if [ -f "${HOME}/.config/env.sh" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.config/env.sh"
fi

# history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
# shellcheck disable=SC2034
SAVEHIST=100000

setopt APPEND_HISTORY        # append to history file, don't overwrite
setopt INC_APPEND_HISTORY    # write to file immediately
setopt SHARE_HISTORY         # share history across sessions
setopt HIST_IGNORE_DUPS      # ignore consecutive duplicates
setopt HIST_REDUCE_BLANKS    # remove superfluous blanks
setopt EXTENDED_HISTORY      # save timestamps

# <<< vars/PS1.zsh

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  sleep 0.1
  # precmd() { precmd() { echo } }
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }\
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8"
fi

if [[ $- == *i* ]]; then
  zshaddhistory() {
    case "$1" in
      fcd$'\n'|fcd' '*$'\n'|fvi$'\n'|fvi' '*$'\n'|fedit$'\n'|fedit' '*$'\n'|ftop$'\n'|ftop' '*$'\n'|fkill$'\n'|fkill' '*$'\n'|fh$'\n'|fh' '*$'\n')
        return 1
        ;;
    esac

    return 0
  }

  bindkey -e
  bindkey '^R' history-incremental-search-backward
  bindkey '^S' history-incremental-search-forward
fi

if [ -f "${HOME}/.config/aliases.list" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.config/aliases.list"
fi

# <<< vars/PATH
