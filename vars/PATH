# Java on MacOS
if [ -d "/opt/homebrew/opt/openjdk/bin" ]; then
  case ":$PATH:" in
    *":/opt/homebrew/opt/openjdk/bin:"*) ;;
    *) PATH="/opt/homebrew/opt/openjdk/bin:$PATH" ;;
  esac
fi

# Java on Linux
java_bin_dir=""
for candidate_dir in \
  /usr/lib/jvm/java-25-openjdk/bin \
  /usr/lib/jvm/java-25-openjdk-amd64/bin \
  /usr/lib/jvm/java-25-openjdk-arm64/bin \
  /usr/lib/jvm/jdk-25/bin \
  /usr/lib/jvm/java-21-openjdk/bin \
  /usr/lib/jvm/java-21-openjdk-amd64/bin \
  /usr/lib/jvm/java-21-openjdk-arm64/bin \
  /usr/lib/jvm/jdk-21/bin \
  /usr/lib/jvm/default-java/bin
do
  if [ -d "$candidate_dir" ]; then
    java_bin_dir="$candidate_dir"
    break
  fi
done

if [ -n "$java_bin_dir" ]; then
  case ":$PATH:" in
    *":$java_bin_dir:"*) ;;
    *) PATH="$java_bin_dir:$PATH" ;;
  esac
fi

# go
if [ -x "/usr/local/go/bin/go" ]; then
  case ":$PATH:" in
    *":/usr/local/go/bin:"*) ;;
    *) PATH="/usr/local/go/bin:$PATH" ;;
  esac

  if [ -d "$HOME/go/bin" ]; then
    case ":$PATH:" in
      *":$HOME/go/bin:"*) ;;
      *) PATH="$HOME/go/bin:$PATH" ;;
    esac
  fi
fi

# Homebrew (brew) on MacOS
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# OS
case ":$PATH:" in
  *":/opt/bin:"*) ;;
  *) PATH="/opt/bin:$PATH" ;;
esac

# Custom scripts
case ":$PATH:" in
  *":/opt/scripts:"*) ;;
  *) PATH="/opt/scripts:$PATH" ;;
esac

# User
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac

export PATH
